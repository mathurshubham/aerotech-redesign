{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aerotech-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-11",
  "routes": [
    { "pattern": "aerotech.shubhammathur.in", "custom_domain": true }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  // D1 for the `leads` table.
  //
  // Create it once with:
  //   wrangler d1 create aerotech-leads
  // then paste the returned database_id below and run `pnpm cf-typegen`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aerotech-leads",
      "database_id": "98e98da9-ec3b-4e13-80d9-a1427713a8c0",
      "migrations_dir": "migrations"
    }
  ]

  // Secrets — do NOT put real values here. Locally they live in `.dev.vars`
  // (see `.dev.vars.example`); in production use:
  //   wrangler secret put RESEND_API_KEY
  //   wrangler secret put TURNSTILE_SECRET_KEY
  //   wrangler secret put LEAD_TO_EMAIL
  //   wrangler secret put LEAD_FROM_EMAIL
  //
  // "vars": {
  //   "RESEND_API_KEY": "",
  //   "TURNSTILE_SECRET_KEY": "",
  //   "LEAD_TO_EMAIL": "info@aerotechss.com",
  //   "LEAD_FROM_EMAIL": "Aerotech Website <leads@aerotechss.com>"
  // }
}
